# Root directory of your icon projects (supports ~ for home)
PROJECT_ROOT=~/Work/Projects/theme_icons

# Set to true only if your machine's SSH config does NOT have a `bitbucket-nhut`
# Host alias (see ~/.ssh/config) and instead reaches Bitbucket via the plain
# `bitbucket.org` host with a default/named identity key. Leave unset/false to
# keep the normal machine config (bitbucket-nhut alias).
USE_DIRECT_GIT_HOST=false

# ── Nucleo project UUIDs per style ─────────────────────────────────────────────
NUCLEO_UUID_GLYPH=<your-glyph-uuid>
NUCLEO_UUID_REGULAR=<your-regular-uuid>
NUCLEO_UUID_BOLD=<your-bold-uuid>
NUCLEO_UUID_LIGHT=<your-light-uuid>
NUCLEO_UUID_ILLUSTRATIONS=<your-illustrations-uuid>
NUCLEO_UUID_ILLUSTRATIONS_DUOTONE=<your-illustrations-duotone-uuid>
NUCLEO_UUID_ILLUSTRATIONS_PART3=<your-illustrations-part3-uuid>

# ── Output subdirectories (relative to PROJECT_ROOT) per style ─────────────────
OUTPUT_SUBDIR_GLYPH=/_Assets/StreamlineIcons/sets/Icons Font Glyph
OUTPUT_SUBDIR_REGULAR=/_Assets/StreamlineIcons/sets/Icons Font Regular
OUTPUT_SUBDIR_BOLD=/_Assets/StreamlineIcons/sets/Icons Font Bold
OUTPUT_SUBDIR_LIGHT=/_Assets/StreamlineIcons/sets/Icons Font Light
OUTPUT_SUBDIR_ILLUSTRATIONS=/_Assets/StreamlineIllustrator
OUTPUT_SUBDIR_ILLUSTRATIONS_DUOTONE=/_Assets/StreamlineDuotoneIcons
OUTPUT_SUBDIR_ILLUSTRATIONS_PART3=/_Assets/StreamlineIllustrator
